# Google Cloud
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1

# Model selection (Gemini)
ROUTER_MODEL=gemini-2.5-flash
HR_POLICY_MODEL=gemini-2.5-flash
BENEFITS_MODEL=gemini-2.5-flash
PAYROLL_MODEL=gemini-2.5-flash
PROCUREMENT_MODEL=gemini-2.5-flash
LEGAL_MODEL=gemini-2.5-pro
COMPLIANCE_MODEL=gemini-2.5-pro
FACILITIES_MODEL=gemini-2.5-flash

# Retrieval backend: stub | agent_search | rag_engine | vertex_ai_search | vector_search
RETRIEVAL_BACKEND=stub

# Required for non-stub backends
AGENT_SEARCH_APP=your-agent-search-app-id
RAG_ENGINE_CORPUS=your-rag-engine-corpus-id
VERTEX_AI_INDEX=your-vertex-ai-index-id
VECTOR_INDEX_ENDPOINT=your-vector-index-endpoint

# Embeddings for vector search
EMBEDDING_MODEL=text-embedding-005

# Guardrails
SAFETY_ENABLED=true

# App
APP_NAME=enterprise-hr-assistant
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Optional: real ticketing target (servicenow, jira, etc.)
TICKETING_SYSTEM=
